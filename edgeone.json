{
  "_comment": "EdgeOne Pages 项目配置：缓存策略 + 安全响应头。放在项目根目录，随项目一起部署。若你的部署方式不支持本文件，请在 EdgeOne 控制台的「规则引擎 / 响应头配置」中按同样内容手工添加。",
  "headers": [
    {
      "_rule": "全站基础安全响应头",
      "source": "/*",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob:; media-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "_rule": "HTML 主文档：短缓存 + 后台静默刷新，兼顾新鲜度与速度",
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "_rule": "HTML 主文档（显式路径）",
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "_rule": "带内容哈希的数据脚本：一年长缓存（文件名随内容变化，无失效风险）",
      "source": "/sports-*.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "_rule": "带内容哈希的样式/脚本：一年长缓存",
      "source": "/portal.*.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "_rule": "带内容哈希的脚本：一年长缓存",
      "source": "/portal.*.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "_rule": "带内容哈希的背景图（WebP / JPEG 回退）：一年长缓存",
      "source": "/mountains.*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "_rule": "社交分享图：一周缓存",
      "source": "/og-image.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "_rule": "门户微调样式：短缓存，便于迭代",
      "source": "/portal.polish.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "_rule": "期刊最新论文数据（每日自动更新）：短缓存",
      "source": "/latest_papers.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "_rule": "学术动态快照（每日自动更新，前端在线/离线都读取）：短缓存",
      "source": "/news-snapshot.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "_rule": "学界动态快照（每日自动更新）：短缓存",
      "source": "/xuejie-snapshot.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
